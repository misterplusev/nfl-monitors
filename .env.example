# ============================================================================
# NFL Unified Odds Monitor — Required Environment Variables
# ============================================================================
# Set these as HuggingFace Space Secrets (Settings → Repository Secrets)
# or as environment variables for local development.
# ============================================================================

# --- Runtime paths ---
# Local standalone: leave unset (defaults to the script's own directory).
# HF Space deployment: ABET_BASE_DIR=/home/user/app
ABET_BASE_DIR=

# --- Supabase (optional) ---
NFL_MONITORS_SUPABASE_URL=https://your-project.supabase.co
NFL_MONITORS_SUPABASE_SERVICE_KEY=your-supabase-service-role-key
NFL_MONITORS_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Discord Webhooks ---
# NEW NFL channels — #nfl-moneylines / #nfl-spreads / #nfl-totals.
# Local dev: discord.com domain works (see .env.nfl.local).
# HF Space deployment: swap to the discordapp.com domain (same IDs/tokens).
DISCORD_WEBHOOK_NFL_MONEYLINE=https://discordapp.com/api/webhooks/CHANNEL_ID/TOKEN
DISCORD_WEBHOOK_NFL_SPREADS=https://discordapp.com/api/webhooks/CHANNEL_ID/TOKEN
DISCORD_WEBHOOK_NFL_TOTALS=https://discordapp.com/api/webhooks/CHANNEL_ID/TOKEN

# --- TheOddsAPI Keys ---
# FOR NOW: same pool as the MLB suite (MLB rotation algorithm, credit state in
# data/runtime/nfl/api_state.json). NFL-dedicated keys can be added later by
# replacing values below — no code change needed.
ODDS_API_KEY_1=your-odds-api-key-1
ODDS_API_KEY_2=your-odds-api-key-2
ODDS_API_KEY_3=your-odds-api-key-3
ODDS_API_KEY_4=your-odds-api-key-4
ODDS_API_KEY_5=your-odds-api-key-5
ODDS_API_KEY_6=your-odds-api-key-6
ODDS_API_KEY_7=your-odds-api-key-7
ODDS_API_KEY_8=your-odds-api-key-8
ODDS_API_KEY_9=your-odds-api-key-9